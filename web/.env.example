# Copy to .env.local for local development. Never commit .env.local.

# The Django/DRF backend's public API origin. Leaving this unset makes
# every API call short-circuit to a typed "not_configured" result with
# zero network calls (see src/lib/api/config.ts) - this is what CI relies
# on for a deterministic, offline production build.
NEXT_PUBLIC_API_BASE_URL=https://shahriyarkhan.onrender.com

# The canonical site origin used for metadata, sitemap, JSON-LD, and OG
# image absolute URLs. Temporary until a permanent domain decision is
# made (docs/rebuild/OPEN_DECISIONS.md #3) - never shahriyarkhan.dev,
# which does not resolve.
NEXT_PUBLIC_SITE_URL=https://shahriyarkhan.vercel.app

# Analytics provider name. Unset (or "none") means the analytics
# abstraction (src/lib/analytics.ts) never registers a provider and every
# trackEvent() call is a total no-op - this is the only supported value
# in this phase; no analytics provider has been chosen yet
# (docs/rebuild/OPEN_DECISIONS.md #19).
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
