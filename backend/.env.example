# Copy to backend/.env for local development (config.settings.development
# loads it via python-dotenv). Never commit backend/.env.

DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=dev-only-not-a-real-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Set to "true" for a zero-setup local Postgres-free run. Leave unset (or
# "false") to use DATABASE_URL / POSTGRES_* below instead.
USE_SQLITE=true

# --- Database (ignored while USE_SQLITE=true) ---
# Either DATABASE_URL, or the individual POSTGRES_* vars below.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
POSTGRES_DB=portfolio_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- CORS / CSRF: must include the frontend's local dev origin ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# --- Media storage (Cloudinary) - leave unset to fall back to local
# filesystem storage under MEDIA_ROOT for local development ---
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Public URLs used in generated links/metadata ---
PUBLIC_BASE_URL=http://localhost:8000
PUBLIC_SITE_URL=http://localhost:3000

# --- Outbound email (contact/service-request notifications) - leave
# unset to use Django's local console email backend for development ---
# EMAIL_HOST=
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_PORT=587
# DEFAULT_FROM_EMAIL=
# ADMIN_NOTIFICATION_EMAIL=

# --- Optional: Gmail API (used by an alternate email delivery path) ---
# GMAIL_API_CLIENT_ID=
# GMAIL_API_CLIENT_SECRET=
# GMAIL_API_REFRESH_TOKEN=
# GMAIL_API_USER_ID=

TIME_ZONE=UTC
